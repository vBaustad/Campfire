<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- One dot per Campfire player on the world map and the battlefield (zone) map.
         The map's own pin pool builds these from the template; the mixin lives in MapPins.lua.
         Two layers on purpose: the fill is tinted with the class colour, the rim never is, so the rim
         stays properly dark for every class and no colour ever lands outside the circle. Small, the
         same size at every zoom, no glow, nothing that pulses. -->
    <Frame name="CampfireMapPinTemplate" mixin="CampfireMapPinMixin" enableMouse="true" virtual="true">
        <Size x="10" y="10"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Dot" file="Interface\AddOns\Campfire\Media\pinfill" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Rim" file="Interface\AddOns\Campfire\Media\pinrim" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>
</Ui>
